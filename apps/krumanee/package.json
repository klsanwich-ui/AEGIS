{
  "name": "krumanee",
  "productName": "KruManee",
  "version": "0.1.0",
  "private": true,
  "description": "ครูมณี (KruManee): hotkey screen teacher with typed ask, Thai voice, and on-screen pointing",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "dev": "npm run start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node dist/test-points.js && node dist/test-actions.js",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "app.krumanee.desktop",
    "productName": "KruManee",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "static/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "KruManee-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ครูมณี",
      "uninstallDisplayName": "ครูมณี (KruManee)",
      "artifactName": "KruManee-Setup.exe"
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "electron": "^35.1.2",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.2"
  }
}
